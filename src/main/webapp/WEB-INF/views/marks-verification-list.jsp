<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ include file="fragments/header.jspf" %>
<section class="page-heading"><div><p class="eyebrow">Academic operations</p><h1>Marks Verification</h1><p class="muted">Review pending marks before they can be included in processed results.</p></div></section>
<section class="filter-panel"><form class="filter-grid" action="<c:url value='/web/marks-verification'/>" method="get"><label>Search<input name="q" value="<c:out value='${q}'/>" placeholder="Student, examination, or subject"></label><c:if test="${platformAdmin}"><label>Tenant<select name="tenantId"><option value="">All tenants</option><c:forEach items="${tenants}" var="tenant"><option value="${tenant.id}" ${tenant.id == selectedTenantId ? 'selected' : ''}><c:out value="${tenant.tenantName}"/></option></c:forEach></select></label></c:if><label>Rows<select name="size"><option value="10" ${pageSize == 10 ? 'selected' : ''}>10</option><option value="25" ${pageSize == 25 ? 'selected' : ''}>25</option><option value="50" ${pageSize == 50 ? 'selected' : ''}>50</option></select></label><div class="filter-actions"><button class="primary" type="submit">Apply</button><a class="button secondary" href="<c:url value='/web/marks-verification'/>">Reset</a></div></form></section>
<section class="panel"><div class="table-wrap"><table class="data-table"><thead><tr><c:if test="${platformAdmin}"><th>Tenant</th></c:if><th>Student</th><th>Examination / Subject</th><th>Marks</th><th>Entered</th><th>Review</th></tr></thead><tbody><c:forEach items="${page.objects}" var="record"><tr><c:if test="${platformAdmin}"><td><c:out value="${record.tenantName}"/></td></c:if><td><c:out value="${record.registrationNumber}"/> — <c:out value="${record.studentName}"/><br><span class="muted"><c:out value="${record.sectionName}"/></span></td><td><c:out value="${record.examinationName}"/> / <c:out value="${record.subjectName}"/></td><td><c:out value="${record.marksObtained}"/> / <c:out value="${record.maximumMarks}"/></td><td><c:out value="${record.examDate}"/></td><td><c:if test="${canVerifyMarks}"><c:url var="verifyUrl" value="/web/marks-verification/${record.id}/verify"><c:if test="${platformAdmin}"><c:param name="tenantId" value="${record.tenantId}"/></c:if></c:url><c:url var="rejectUrl" value="/web/marks-verification/${record.id}/reject"><c:if test="${platformAdmin}"><c:param name="tenantId" value="${record.tenantId}"/></c:if></c:url><form class="action-form" method="post" action="${verifyUrl}"><input type="text" name="remarks" maxlength="1000" placeholder="Optional remarks"><button class="action-button primary" type="submit">Verify</button></form><form class="action-form" method="post" action="${rejectUrl}"><input type="text" name="remarks" maxlength="1000" placeholder="Reason required" required><button class="action-button secondary" type="submit">Reject</button></form></c:if><c:if test="${not canVerifyMarks}"><span class="muted">Read only</span></c:if></td></tr></c:forEach></tbody></table></div><%@ include file="fragments/data-table-empty.jspf" %><%@ include file="fragments/pagination.jspf" %></section>
<%@ include file="fragments/footer.jspf" %>
