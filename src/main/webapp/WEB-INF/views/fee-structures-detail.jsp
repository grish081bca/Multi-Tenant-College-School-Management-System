<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %><%@ include file="fragments/header.jspf" %>
<section class="page-heading"><div><p class="eyebrow">Finance</p><h1><c:out value="${record.name}"/></h1><p class="muted"><c:out value="${record.code}"/></p></div><a class="button secondary" href="<c:url value='/web/fee-structures'/>">Back to fee structures</a></section><section class="panel detail-grid"><div><span class="meta-label">Program</span><strong><c:out value="${record.programName}"/></strong></div><div><span class="meta-label">Academic year / semester</span><strong><c:out value="${record.academicYearName}"/> / <c:out value="${record.semesterName}"/></strong></div><div><span class="meta-label">Amount</span><strong><c:out value="${record.amount}"/></strong></div><div><span class="meta-label">Due date</span><strong><c:out value="${record.dueDate}"/></strong></div><div><span class="meta-label">Status</span><strong><c:out value="${record.status}"/></strong></div><div><span class="meta-label">Description</span><strong><c:out value="${record.description}"/></strong></div><c:if test="${canWrite}"><div><c:url var="editUrl" value="/web/fee-structures/${record.id}/edit"><c:if test="${platformAdmin}"><c:param name="tenantId" value="${record.tenantId}"/></c:if></c:url><a class="button primary" href="${editUrl}">Edit</a></div></c:if></section><%@ include file="fragments/footer.jspf" %>
