<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %><%@ include file="fragments/header.jspf" %>
<section class="page-heading"><div><p class="eyebrow">Student self-service</p><h1>Welcome, <c:out value="${portal.studentName}"/></h1><p class="muted">Registration <c:out value="${portal.registrationNumber}"/> · <c:out value="${portal.programName}"/> · <c:out value="${portal.academicYearName}"/> / <c:out value="${portal.semesterName}"/> / <c:out value="${portal.sectionName}"/></p></div><a class="button secondary" href="<c:url value='/web/notifications'/>">Notifications</a></section>
<section class="panel"><h2>Results</h2><div class="table-wrap"><table class="data-table"><thead><tr><th>Year / semester</th><th>Marks</th><th>Percentage</th><th>GPA</th></tr></thead><tbody><c:forEach items="${portal.results}" var="result"><tr><td><c:out value="${result.academicYearName}"/> / <c:out value="${result.semesterName}"/></td><td><c:out value="${result.totalMarksObtained}"/> / <c:out value="${result.totalMaximumMarks}"/></td><td><c:out value="${result.percentage}"/>%</td><td><c:out value="${result.gpa}"/></td></tr></c:forEach></tbody></table></div><c:if test="${empty portal.results}"><p class="muted">No processed results are available.</p></c:if></section>
<section class="panel"><h2>Fee balance</h2><div class="table-wrap"><table class="data-table"><thead><tr><th>Fee</th><th>Amount</th><th>Paid</th><th>Balance</th><th>Due date</th></tr></thead><tbody><c:forEach items="${portal.fees}" var="fee"><tr><td><c:out value="${fee.feeName}"/> (<c:out value="${fee.feeCode}"/>)</td><td><c:out value="${fee.amount}"/></td><td><c:out value="${fee.paid}"/></td><td><c:out value="${fee.balance}"/></td><td><c:out value="${fee.dueDate}"/></td></tr></c:forEach></tbody></table></div><c:if test="${empty portal.fees}"><p class="muted">No active fee structure applies to the current enrollment.</p></c:if></section>
<section class="panel"><div class="page-heading"><div><h2>Payment receipts</h2><p class="muted">Use Print to save a copy of this receipt history.</p></div><button class="button secondary" type="button" onclick="window.print()">Print</button></div><div class="table-wrap"><table class="data-table"><thead><tr><th>Receipt</th><th>Fee</th><th>Amount</th><th>Method</th><th>Collected</th></tr></thead><tbody><c:forEach items="${portal.receipts}" var="receipt"><tr><td><c:out value="${receipt.receiptNumber}"/></td><td><c:out value="${receipt.feeName}"/></td><td><c:out value="${receipt.amount}"/></td><td><c:out value="${receipt.paymentMethod}"/></td><td><c:out value="${receipt.collectedAtDisplay}"/></td></tr></c:forEach></tbody></table></div><c:if test="${empty portal.receipts}"><p class="muted">No payments have been recorded.</p></c:if></section>
<section class="panel"><h2>Certificates</h2><div class="table-wrap"><table class="data-table"><thead><tr><th>Certificate number</th><th>Title</th><th>Type</th><th>Issued</th></tr></thead><tbody><c:forEach items="${portal.certificates}" var="certificate"><tr><td><c:out value="${certificate.certificateNumber}"/></td><td><c:out value="${certificate.title}"/></td><td><c:out value="${certificate.certificateType}"/></td><td><c:out value="${certificate.issuedOn}"/></td></tr></c:forEach></tbody></table></div><c:if test="${empty portal.certificates}"><p class="muted">No certificates are available.</p></c:if></section>
<section class="panel"><h2>Recent attendance</h2><div class="table-wrap"><table class="data-table"><thead><tr><th>Date</th><th>Section</th><th>Status</th></tr></thead><tbody><c:forEach items="${portal.attendance}" var="record"><tr><td><c:out value="${record.attendanceDate}"/></td><td><c:out value="${record.sectionName}"/></td><td><c:out value="${record.status}"/></td></tr></c:forEach></tbody></table></div><c:if test="${empty portal.attendance}"><p class="muted">No attendance records are available.</p></c:if></section>
<%@ include file="fragments/footer.jspf" %>
