<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %><%@ include file="fragments/header.jspf" %>
<section class="page-heading"><div><p class="eyebrow">Finance</p><h1>Fee Structures</h1><p class="muted">Configure charges by program and academic period.</p></div><c:if test="${canWrite}"><c:url var="addUrl" value="/web/fee-structures/add"><c:if test="${platformAdmin and not empty selectedTenantId}"><c:param name="tenantId" value="${selectedTenantId}"/></c:if></c:url><a class="button primary" href="${addUrl}">Add Fee Structure</a></c:if></section>
<section class="filter-panel"><form class="filter-grid" action="<c:url value='/web/fee-structures'/>" method="get"><label>Search<input name="q" value="<c:out value='${q}'/>" placeholder="Code, charge, program, or semester"></label><c:if test="${platformAdmin}"><label>Tenant<select name="tenantId"><option value="">All tenants</option><c:forEach items="${tenants}" var="tenant"><option value="${tenant.id}" ${tenant.id == selectedTenantId ? 'selected' : ''}><c:out value="${tenant.tenantName}"/></option></c:forEach></select></label></c:if><label>Status<select name="status"><option value="">All</option><c:forEach items="${statuses}" var="value"><option value="${value}" ${value == selectedStatus ? 'selected' : ''}><c:out value="${value}"/></option></c:forEach></select></label><button class="primary" type="submit">Apply</button></form></section>
<section class="panel"><div class="table-wrap"><table class="data-table"><thead><tr><c:if test="${platformAdmin}"><th>Tenant</th></c:if><th>Code / charge</th><th>Program</th><th>Year / semester</th><th>Amount</th><th>Due date</th><th>Status</th><th></th></tr></thead><tbody><c:forEach items="${page.objects}" var="item"><tr><c:if test="${platformAdmin}"><td><c:out value="${item.tenantName}"/></td></c:if><td><strong><c:out value="${item.code}"/></strong><br><c:out value="${item.name}"/></td><td><c:out value="${item.programName}"/></td><td><c:out value="${item.academicYearName}"/> / <c:out value="${item.semesterName}"/></td><td><c:out value="${item.amount}"/></td><td><c:out value="${item.dueDate}"/></td><td><c:out value="${item.status}"/></td><td><c:url var="detailUrl" value="/web/fee-structures/${item.id}"><c:if test="${platformAdmin}"><c:param name="tenantId" value="${item.tenantId}"/></c:if></c:url><a class="action-button secondary" href="${detailUrl}">View</a></td></tr></c:forEach></tbody></table></div><c:if test="${empty page.objects}"><%@ include file="fragments/data-table-empty.jspf" %></c:if><%@ include file="fragments/pagination.jspf" %></section><%@ include file="fragments/footer.jspf" %>
