<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ include file="fragments/header.jspf" %>
<section class="page-heading"><div><p class="eyebrow">Academic operations</p><h1>Marks Entry</h1><p class="muted">Enter marks for active student enrollments and examinations.</p></div><c:if test="${canWriteMarks}"><c:url var="addMarksUrl" value="/web/marks/add"><c:if test="${platformAdmin and not empty selectedTenantId}"><c:param name="tenantId" value="${selectedTenantId}"/></c:if></c:url><a class="button primary" href="${addMarksUrl}"><i class="fa-solid fa-plus" aria-hidden="true"></i>Enter Marks</a></c:if></section>
<section class="filter-panel"><form class="filter-grid" action="<c:url value='/web/marks'/>" method="get">
    <label>Search<input name="q" value="<c:out value='${q}'/>" placeholder="Student, examination, or subject"></label>
    <c:if test="${platformAdmin}"><label>Tenant<select name="tenantId" id="marksTenantSelect"><option value="">All tenants</option><c:forEach items="${tenants}" var="tenant"><option value="${tenant.id}" ${tenant.id == selectedTenantId ? 'selected' : ''}><c:out value="${tenant.tenantName}"/></option></c:forEach></select></label></c:if>
    <label>Verification<select name="verificationStatus"><option value="">All</option><c:forEach items="${verificationStatuses}" var="value"><option value="${value}" ${value == selectedVerificationStatus ? 'selected' : ''}><c:out value="${value}"/></option></c:forEach></select></label>
    <label>Rows<select name="size"><option value="10" ${pageSize == 10 ? 'selected' : ''}>10</option><option value="25" ${pageSize == 25 ? 'selected' : ''}>25</option><option value="50" ${pageSize == 50 ? 'selected' : ''}>50</option></select></label>
    <div class="filter-actions"><button class="primary" type="submit">Apply</button><a class="button secondary" href="<c:url value='/web/marks'/>">Reset</a></div>
</form></section>
<section class="panel"><div class="table-wrap"><table class="data-table"><thead><tr><c:if test="${platformAdmin}"><th>Tenant</th></c:if><th>Student</th><th>Examination</th><th>Subject / Section</th><th>Marks</th><th>Verification</th><th>Action</th></tr></thead><tbody>
<c:forEach items="${page.objects}" var="record"><tr><c:if test="${platformAdmin}"><td><c:out value="${record.tenantName}"/></td></c:if><td><c:out value="${record.registrationNumber}"/> — <c:out value="${record.studentName}"/></td><td><c:out value="${record.examinationCode}"/> / <c:out value="${record.examinationName}"/><br><span class="muted"><c:out value="${record.examDate}"/></span></td><td><c:out value="${record.subjectName}"/> / <c:out value="${record.sectionName}"/></td><td><c:out value="${record.marksObtained}"/> / <c:out value="${record.maximumMarks}"/></td><td><span class="status-pill status-${record.verificationStatus}"><c:out value="${record.verificationStatus}"/></span></td><td class="actions-cell"><c:url var="recordUrl" value="/web/marks/${record.id}"><c:if test="${platformAdmin}"><c:param name="tenantId" value="${record.tenantId}"/></c:if></c:url><a class="action-button secondary" href="${recordUrl}"><i class="fa-solid fa-eye" aria-hidden="true"></i><span>View</span></a><c:if test="${canWriteMarks and record.verificationStatus != 'VERIFIED'}"><c:url var="editUrl" value="/web/marks/${record.id}/edit"><c:if test="${platformAdmin}"><c:param name="tenantId" value="${record.tenantId}"/></c:if></c:url><a class="action-button secondary" href="${editUrl}"><i class="fa-solid fa-pen-to-square" aria-hidden="true"></i><span>Edit</span></a></c:if></td></tr></c:forEach>
</tbody></table></div><%@ include file="fragments/data-table-empty.jspf" %><%@ include file="fragments/pagination.jspf" %></section>
<%@ include file="fragments/footer.jspf" %>
