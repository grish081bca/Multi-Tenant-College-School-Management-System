<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ include file="fragments/header.jspf" %>
<section class="page-heading"><div><p class="eyebrow">Academic operations</p><h1>Results Processing &amp; GPA</h1><p class="muted">Process results from verified marks. GPA is credit-hour weighted on a 4.0 scale.</p></div></section>
<c:if test="${canProcessResults}"><section class="form-panel"><form class="form-grid enterprise-form" method="post" action="<c:url value='/web/results/process'/>"><c:if test="${platformAdmin}"><label>Tenant<select id="resultTenantSelect" name="tenantId" required><option value="">Select tenant to load enrollments</option><c:forEach items="${tenants}" var="tenant"><option value="${tenant.id}" ${tenant.id == selectedTenantId ? 'selected' : ''}><c:out value="${tenant.tenantName}"/></option></c:forEach></select></label></c:if><label>Student enrollment<select name="enrollmentId" required><option value="">Select enrollment</option><c:forEach items="${enrollments}" var="enrollment"><option value="${enrollment.id}"><c:out value="${enrollment.registrationNumber}"/> — <c:out value="${enrollment.studentName}"/> / <c:out value="${enrollment.programName}"/> / <c:out value="${enrollment.semesterName}"/></option></c:forEach></select></label><div class="form-actions"><button class="primary" type="submit">Process result</button></div></form></section></c:if>
<section class="filter-panel"><form class="filter-grid" action="<c:url value='/web/results'/>" method="get"><label>Search<input name="q" value="<c:out value='${q}'/>" placeholder="Student, program, or semester"></label><c:if test="${platformAdmin}"><label>Tenant<select name="tenantId"><option value="">All tenants</option><c:forEach items="${tenants}" var="tenant"><option value="${tenant.id}" ${tenant.id == selectedTenantId ? 'selected' : ''}><c:out value="${tenant.tenantName}"/></option></c:forEach></select></label></c:if><label>Rows<select name="size"><option value="10" ${pageSize == 10 ? 'selected' : ''}>10</option><option value="25" ${pageSize == 25 ? 'selected' : ''}>25</option><option value="50" ${pageSize == 50 ? 'selected' : ''}>50</option></select></label><div class="filter-actions"><button class="primary" type="submit">Apply</button><a class="button secondary" href="<c:url value='/web/results'/>">Reset</a></div></form></section>
<section class="panel"><div class="table-wrap"><table class="data-table"><thead><tr><c:if test="${platformAdmin}"><th>Tenant</th></c:if><th>Student</th><th>Program / Term</th><th>Marks</th><th>Percentage</th><th>GPA</th><th>Processed</th><th>Action</th></tr></thead><tbody><c:forEach items="${page.objects}" var="result"><tr><c:if test="${platformAdmin}"><td><c:out value="${result.tenantName}"/></td></c:if><td><c:out value="${result.registrationNumber}"/> — <c:out value="${result.studentName}"/></td><td><c:out value="${result.programName}"/> / <c:out value="${result.academicYearName}"/> / <c:out value="${result.semesterName}"/></td><td><c:out value="${result.totalMarksObtained}"/> / <c:out value="${result.totalMaximumMarks}"/></td><td><c:out value="${result.percentage}"/>%</td><td><strong><c:out value="${result.gpa}"/></strong> / 4.00</td><td><c:out value="${result.processedAtDisplay}"/></td><td><c:url var="resultUrl" value="/web/results/${result.id}"><c:if test="${platformAdmin}"><c:param name="tenantId" value="${result.tenantId}"/></c:if></c:url><a class="action-button secondary" href="${resultUrl}"><i class="fa-solid fa-eye" aria-hidden="true"></i><span>Details</span></a></td></tr></c:forEach></tbody></table></div><%@ include file="fragments/data-table-empty.jspf" %><%@ include file="fragments/pagination.jspf" %></section>
<c:if test="${platformAdmin and canProcessResults}"><script>document.getElementById('resultTenantSelect').addEventListener('change',function(){var target='<c:url value="/web/results"/>',value=this.value;window.location.assign(value?target+'?tenantId='+encodeURIComponent(value):target);});</script></c:if>
<%@ include file="fragments/footer.jspf" %>
