<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %><%@ include file="fragments/header.jspf" %>
<section class="page-heading"><div><p class="eyebrow">Finance</p><h1>Collect Student Fee</h1><p class="muted">A printable receipt is generated as part of the payment transaction.</p></div></section>
<section class="form-panel"><form class="form-grid enterprise-form" method="post" action="<c:url value='/web/fee-collections'/>"><c:if test="${platformAdmin}"><label>Tenant<select id="tenantSelect" name="tenantId"><option value="">Select tenant to load fee records</option><c:forEach items="${tenants}" var="tenant"><option value="${tenant.id}" ${tenant.id == selectedTenantId ? 'selected' : ''}><c:out value="${tenant.tenantName}"/></option></c:forEach></select></label></c:if><label>Student enrollment<select name="enrollmentId" required><option value="">Select enrollment</option><c:forEach items="${enrollments}" var="item"><option value="${item.id}" ${item.id == form.enrollmentId ? 'selected' : ''}><c:out value="${item.registrationNumber}"/> — <c:out value="${item.studentName}"/> / <c:out value="${item.programName}"/> / <c:out value="${item.semesterName}"/></option></c:forEach></select></label><label>Fee structure<select name="feeStructureId" required><option value="">Select fee charge</option><c:forEach items="${feeStructures}" var="item"><option value="${item.id}" ${item.id == form.feeStructureId ? 'selected' : ''}><c:out value="${item.code}"/> — <c:out value="${item.name}"/> / <c:out value="${item.amount}"/></option></c:forEach></select></label><label>Payment amount<input type="number" name="amount" min="0.01" step="0.01" value="<c:out value='${form.amount}'/>" required></label><label>Payment method<select name="paymentMethod" required><option value="">Select method</option><c:forEach items="${paymentMethods}" var="method"><option value="${method}" ${method == form.paymentMethod ? 'selected' : ''}><c:out value="${method}"/></option></c:forEach></select></label><label>Reference number (required for bank transfer or cheque)<input name="referenceNumber" maxlength="120" value="<c:out value='${form.referenceNumber}'/>"></label><div class="form-actions"><button class="primary" type="submit">Collect Payment and Generate Receipt</button><a class="button secondary" href="<c:url value='/web/fee-collections'/>">Cancel</a></div></form></section>
<c:if test="${platformAdmin}"><script>document.getElementById('tenantSelect').addEventListener('change',function(){var v=this.value;window.location.assign('<c:url value="/web/fee-collections/add"/>'+(v?'?tenantId='+encodeURIComponent(v):''));});</script></c:if><%@ include file="fragments/footer.jspf" %>
