<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ include file="fragments/header.jspf" %>
<c:url var="marksListUrl" value="/web/marks"><c:if test="${platformAdmin}"><c:param name="tenantId" value="${record.tenantId}"/></c:if></c:url>
<section class="tenant-detail-hero"><div class="tenant-identity"><span class="tenant-avatar"><i class="fa-solid fa-file-pen" aria-hidden="true"></i></span><div><span class="eyebrow">Marks Entry</span><h1><c:out value="${record.studentName}"/></h1><div class="tenant-meta"><span><c:out value="${record.registrationNumber}"/></span></div></div></div><div class="tenant-hero-actions"><span class="status-pill status-${record.verificationStatus}"><c:out value="${record.verificationStatus}"/></span><a class="button secondary" href="${marksListUrl}">Back</a><c:if test="${canWriteMarks and record.verificationStatus != 'VERIFIED'}"><c:url var="editUrl" value="/web/marks/${record.id}/edit"><c:if test="${platformAdmin}"><c:param name="tenantId" value="${record.tenantId}"/></c:if></c:url><a class="button primary" href="${editUrl}">Edit</a></c:if></div></section>
<section class="tenant-info-panel"><div class="tenant-section-heading"><span><i class="fa-solid fa-circle-info" aria-hidden="true"></i></span><div><h2>Marks details</h2></div></div><div class="tenant-detail-list"><c:if test="${platformAdmin}"><div><span>Tenant</span><strong><c:out value="${record.tenantName}"/></strong></div></c:if><div><span>Examination</span><strong><c:out value="${record.examinationCode}"/> — <c:out value="${record.examinationName}"/></strong></div><div><span>Subject / Section</span><strong><c:out value="${record.subjectName}"/> / <c:out value="${record.sectionName}"/></strong></div><div><span>Exam date</span><strong><c:out value="${record.examDate}"/></strong></div><div><span>Marks</span><strong><c:out value="${record.marksObtained}"/> / <c:out value="${record.maximumMarks}"/></strong></div><c:if test="${not empty record.reviewedBy}"><div><span>Reviewed by</span><strong><c:out value="${record.reviewedBy}"/> at <c:out value="${record.reviewedAtDisplay}"/></strong></div></c:if><c:if test="${not empty record.verificationRemarks}"><div><span>Review remarks</span><strong><c:out value="${record.verificationRemarks}"/></strong></div></c:if></div></section>
<section class="tenant-info-panel tenant-audit-panel"><div class="tenant-section-heading"><span><i class="fa-solid fa-clock-rotate-left" aria-hidden="true"></i></span><div><h2>Entity Change Logs</h2></div></div><div class="table-wrap"><table class="data-table"><thead><tr><th>When</th><th>Action</th><th>Field</th><th>Old value</th><th>New value</th><th>Remarks</th></tr></thead><tbody><c:forEach items="${changeLogs}" var="log"><tr><td><c:out value="${log.createdAtDisplay}"/></td><td><c:out value="${log.action}"/></td><td><c:out value="${empty log.fieldName ? '-' : log.fieldName}"/></td><td><c:out value="${empty log.oldValue ? '-' : log.oldValue}"/></td><td><c:out value="${empty log.newValue ? '-' : log.newValue}"/></td><td><c:out value="${empty log.remarks ? '-' : log.remarks}"/></td></tr></c:forEach><c:if test="${empty changeLogs}"><tr><td class="empty-cell" colspan="6">No change logs found.</td></tr></c:if></tbody></table></div></section>
<%@ include file="fragments/footer.jspf" %>
