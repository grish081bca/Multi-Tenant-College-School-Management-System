<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ include file="fragments/header.jspf" %>
<c:url var="marksListUrl" value="/web/marks"><c:if test="${platformAdmin and not empty selectedTenantId}"><c:param name="tenantId" value="${selectedTenantId}"/></c:if></c:url>
<section class="page-heading"><div><p class="eyebrow">Academic operations</p><h1>${isEdit ? 'Update Marks' : 'Enter Marks'}</h1><p class="muted">Saved marks are submitted for verification.</p></div></section>
<section class="form-panel"><c:choose><c:when test="${isEdit}"><c:url var="formAction" value="/web/marks/${record.id}"/></c:when><c:otherwise><c:url var="formAction" value="/web/marks"/></c:otherwise></c:choose><form class="form-grid enterprise-form" action="${formAction}" method="post">
    <c:if test="${platformAdmin}"><c:choose><c:when test="${isEdit}"><input type="hidden" name="tenantId" value="${selectedTenantId}"><label>Tenant<input value="<c:out value='${record.tenantName}'/>" readonly></label></c:when><c:otherwise><label>Tenant<select id="marksTenantSelect" name="tenantId" required><option value="">Select tenant to load records</option><c:forEach items="${tenants}" var="tenant"><option value="${tenant.id}" ${tenant.id == selectedTenantId ? 'selected' : ''}><c:out value="${tenant.tenantName}"/></option></c:forEach></select></label></c:otherwise></c:choose></c:if>
    <label>Examination<select name="examinationId" required><option value="">Select examination</option><c:forEach items="${examinations}" var="exam"><option value="${exam.id}" ${exam.id == form.examinationId ? 'selected' : ''}><c:out value="${exam.code}"/> — <c:out value="${exam.name}"/> / <c:out value="${exam.subjectName}"/> / <c:out value="${exam.examDate}"/></option></c:forEach></select></label>
    <label>Student enrollment<select name="enrollmentId" required><option value="">Select enrollment</option><c:forEach items="${enrollments}" var="enrollment"><option value="${enrollment.id}" ${enrollment.id == form.enrollmentId ? 'selected' : ''}><c:out value="${enrollment.registrationNumber}"/> — <c:out value="${enrollment.studentName}"/> / <c:out value="${enrollment.sectionName}"/> / <c:out value="${enrollment.semesterName}"/></option></c:forEach></select></label>
    <label>Marks obtained<input type="number" name="marksObtained" min="0" step="0.01" max="99999.99" value="<c:out value='${form.marksObtained}'/>" required></label>
    <c:if test="${isEdit}"><label>Remarks (optional)<textarea name="remarks" rows="2"></textarea></label></c:if>
    <div class="form-actions"><button class="primary" type="submit">${isEdit ? 'Update and resubmit' : 'Submit for verification'}</button><a class="button secondary" href="${marksListUrl}">Cancel</a></div>
</form></section>
<c:if test="${platformAdmin and not isEdit}"><script>document.getElementById('marksTenantSelect').addEventListener('change',function(){var target='<c:url value="/web/marks/add"/>',value=this.value;window.location.assign(value?target+'?tenantId='+encodeURIComponent(value):target);});</script></c:if>
<%@ include file="fragments/footer.jspf" %>
