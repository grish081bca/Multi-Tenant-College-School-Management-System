<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %><%@ include file="fragments/header.jspf" %>
<section class="page-heading"><div><p class="eyebrow">Academic records</p><h1>Issue Student Certificate</h1><p class="muted">Issue one certificate type per enrollment. Issued certificates remain in the audit history if revoked.</p></div></section>
<section class="form-panel"><form class="form-grid enterprise-form" action="<c:url value='/web/certificates'/>" method="post"><c:if test="${platformAdmin}"><label>Tenant<select id="tenantSelect" name="tenantId"><option value="">Select tenant to load enrollments</option><c:forEach items="${tenants}" var="tenant"><option value="${tenant.id}" ${tenant.id == selectedTenantId ? 'selected' : ''}><c:out value="${tenant.tenantName}"/></option></c:forEach></select></label></c:if><label>Student enrollment<select name="enrollmentId" required><option value="">Select enrollment</option><c:forEach items="${enrollments}" var="enrollment"><option value="${enrollment.id}" ${enrollment.id == form.enrollmentId ? 'selected' : ''}><c:out value="${enrollment.registrationNumber}"/> — <c:out value="${enrollment.studentName}"/> / <c:out value="${enrollment.programName}"/></option></c:forEach></select></label><label>Certificate type<input name="certificateType" maxlength="60" value="<c:out value='${form.certificateType}'/>" placeholder="COMPLETION, CHARACTER, TRANSCRIPT" required></label><label>Certificate title<input name="title" maxlength="160" value="<c:out value='${form.title}'/>" required></label><label>Issue date<input type="date" name="issuedOn" value="<c:out value='${form.issuedOn}'/>" required></label><label>Description<textarea name="description" rows="3" maxlength="1000"><c:out value="${form.description}"/></textarea></label><div class="form-actions"><button class="primary" type="submit">Issue Certificate</button><a class="button secondary" href="<c:url value='/web/certificates'/>">Cancel</a></div></form></section>
<c:if test="${platformAdmin}"><script>document.getElementById('tenantSelect').addEventListener('change',function(){var v=this.value;window.location.assign('<c:url value="/web/certificates/add"/>'+(v?'?tenantId='+encodeURIComponent(v):''));});</script></c:if><%@ include file="fragments/footer.jspf" %>
