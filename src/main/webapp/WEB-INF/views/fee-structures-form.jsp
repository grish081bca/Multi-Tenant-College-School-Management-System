<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %><%@ include file="fragments/header.jspf" %>
<section class="page-heading"><div><p class="eyebrow">Finance</p><h1>${isEdit ? 'Update Fee Structure' : 'Add Fee Structure'}</h1><p class="muted">Paid structures retain their amount and academic scope.</p></div></section>
<section class="form-panel"><c:choose><c:when test="${isEdit}"><c:url var="formAction" value="/web/fee-structures/${record.id}"/></c:when><c:otherwise><c:url var="formAction" value="/web/fee-structures"/></c:otherwise></c:choose><form class="form-grid enterprise-form" method="post" action="${formAction}"><c:if test="${platformAdmin}"><label>Tenant<select id="tenantSelect" name="tenantId"><option value="">Select tenant</option><c:forEach items="${tenants}" var="tenant"><option value="${tenant.id}" ${tenant.id == selectedTenantId ? 'selected' : ''}><c:out value="${tenant.tenantName}"/></option></c:forEach></select></label></c:if><label>Program<select name="programId" required><option value="">Select program</option><c:forEach items="${programs}" var="item"><option value="${item.id}" ${item.id == form.programId ? 'selected' : ''}><c:out value="${item.code}"/> — <c:out value="${item.name}"/></option></c:forEach></select></label><label>Academic year<select name="academicYearId" required><option value="">Select academic year</option><c:forEach items="${academicYears}" var="item"><option value="${item.id}" ${item.id == form.academicYearId ? 'selected' : ''}><c:out value="${item.name}"/></option></c:forEach></select></label><label>Semester<select name="semesterId" required><option value="">Select semester</option><c:forEach items="${semesters}" var="item"><option value="${item.id}" ${item.id == form.semesterId ? 'selected' : ''}><c:out value="${item.name}"/></option></c:forEach></select></label><label>Fee code<input name="code" maxlength="50" value="<c:out value='${form.code}'/>" required></label><label>Fee name<input name="name" maxlength="160" value="<c:out value='${form.name}'/>" required></label><label>Amount<input type="number" name="amount" min="0.01" step="0.01" value="<c:out value='${form.amount}'/>" required></label><label>Due date<input type="date" name="dueDate" value="<c:out value='${form.dueDate}'/>"/></label><label>Status<select name="status"><c:forEach items="${statuses}" var="value"><option value="${value}" ${value == form.status ? 'selected' : ''}><c:out value="${value}"/></option></c:forEach></select></label><label>Description<textarea name="description" maxlength="1000" rows="3"><c:out value="${form.description}"/></textarea></label><div class="form-actions"><button class="primary" type="submit">Save Fee Structure</button><a class="button secondary" href="<c:url value='/web/fee-structures'/>">Cancel</a></div></form></section>
<c:if test="${platformAdmin}"><script>document.getElementById('tenantSelect').addEventListener('change',function(){var v=this.value;window.location.assign('<c:url value="/web/fee-structures/add"/>'+(v?'?tenantId='+encodeURIComponent(v):''));});</script></c:if><%@ include file="fragments/footer.jspf" %>
