<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %><%@ include file="fragments/header.jspf" %>
<section class="page-heading"><div><p class="eyebrow">Communication</p><h1>${empty id ? 'Create Notice Draft' : 'Edit Notice Draft'}</h1><p class="muted">Published notices become inbox notifications for active users in the selected audience.</p></div></section>
<section class="form-panel"><c:choose><c:when test="${not empty id}"><c:url var="formAction" value="/web/notices/${id}"/></c:when><c:otherwise><c:url var="formAction" value="/web/notices"/></c:otherwise></c:choose><form class="form-grid enterprise-form" method="post" action="${formAction}"><c:if test="${platformAdmin}"><label>Tenant<select id="tenantSelect" name="tenantId"><option value="">Select tenant</option><c:forEach items="${tenants}" var="tenant"><option value="${tenant.id}" ${tenant.id == selectedTenantId ? 'selected' : ''}><c:out value="${tenant.tenantName}"/></option></c:forEach></select></label></c:if><label>Title<input name="title" maxlength="160" value="<c:out value='${form.title}'/>" required></label><label>Audience<select name="audience" required><option value="">Select audience</option><c:forEach items="${audiences}" var="audience"><option value="${audience}" ${audience == form.audience ? 'selected' : ''}><c:out value="${audience}"/></option></c:forEach></select></label><label>Message<textarea name="body" rows="8" maxlength="8000" required><c:out value="${form.body}"/></textarea></label><label>Description (optional)<textarea name="description" rows="2" maxlength="1000"><c:out value="${form.description}"/></textarea></label><div class="form-actions"><button class="primary" type="submit">Save Draft</button><a class="button secondary" href="<c:url value='/web/notices'/>">Cancel</a></div></form></section>
<c:if test="${platformAdmin}"><script>document.getElementById('tenantSelect').addEventListener('change',function(){var v=this.value;window.location.assign('<c:url value="/web/notices/add"/>'+(v?'?tenantId='+encodeURIComponent(v):''));});</script></c:if><%@ include file="fragments/footer.jspf" %>
