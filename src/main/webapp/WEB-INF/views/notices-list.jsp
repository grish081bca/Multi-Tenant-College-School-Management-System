<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %><%@ include file="fragments/header.jspf" %>
<section class="page-heading"><div><p class="eyebrow">Communication</p><h1>Notice Management</h1><p class="muted">Drafts can be edited. Publishing creates recipient inbox notifications.</p></div><c:if test="${canWrite}"><c:url var="addUrl" value="/web/notices/add"><c:if test="${platformAdmin and not empty selectedTenantId}"><c:param name="tenantId" value="${selectedTenantId}"/></c:if></c:url><a class="button primary" href="${addUrl}">Create Notice</a></c:if></section>
<section class="filter-panel"><form class="filter-grid" action="<c:url value='/web/notices'/>" method="get"><label>Search<input name="q" value="<c:out value='${q}'/>" placeholder="Title or notice code"></label><c:if test="${platformAdmin}"><label>Tenant<select name="tenantId"><option value="">All tenants</option><c:forEach items="${tenants}" var="tenant"><option value="${tenant.id}" ${tenant.id == selectedTenantId ? 'selected' : ''}><c:out value="${tenant.tenantName}"/></option></c:forEach></select></label></c:if><label>Status<select name="status"><option value="">All</option><c:forEach items="${statuses}" var="value"><option value="${value}" ${value == selectedStatus ? 'selected' : ''}><c:out value="${value}"/></option></c:forEach></select></label><button class="primary" type="submit">Apply</button></form></section>
<section class="panel"><div class="table-wrap"><table class="data-table"><thead><tr><c:if test="${platformAdmin}"><th>Tenant</th></c:if><th>Title</th><th>Audience</th><th>Status</th><th>Published</th><th>Actions</th></tr></thead><tbody><c:forEach items="${page.objects}" var="item"><tr><c:if test="${platformAdmin}"><td><c:out value="${item.tenantName}"/></td></c:if><td><strong><c:out value="${item.title}"/></strong><br><span class="muted"><c:out value="${item.code}"/></span></td><td><c:out value="${item.audience}"/></td><td><c:out value="${item.status}"/></td><td><c:out value="${item.publishedAtDisplay}"/></td><td class="actions-cell"><c:if test="${canWrite and item.status == 'DRAFT'}"><c:url var="editUrl" value="/web/notices/${item.id}/edit"><c:if test="${platformAdmin}"><c:param name="tenantId" value="${item.tenantId}"/></c:if></c:url><a class="action-button secondary" href="${editUrl}">Edit</a><form method="post" action="<c:url value='/web/notices/${item.id}/publish'/>"><c:if test="${platformAdmin}"><input type="hidden" name="tenantId" value="${item.tenantId}"/></c:if><button class="action-button primary" type="submit">Publish</button></form></c:if><c:if test="${canWrite and item.status == 'PUBLISHED'}"><form method="post" action="<c:url value='/web/notices/${item.id}/archive'/>"><c:if test="${platformAdmin}"><input type="hidden" name="tenantId" value="${item.tenantId}"/></c:if><button class="action-button secondary" type="submit">Archive</button></form></c:if></td></tr></c:forEach></tbody></table></div><c:if test="${empty page.objects}"><%@ include file="fragments/data-table-empty.jspf" %></c:if><%@ include file="fragments/pagination.jspf" %></section><%@ include file="fragments/footer.jspf" %>
