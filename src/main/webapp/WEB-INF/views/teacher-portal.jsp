<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %><%@ include file="fragments/header.jspf" %>
<section class="page-heading"><div><p class="eyebrow">Teacher self-service</p><h1>Welcome, <c:out value="${portal.teacherName}"/></h1><p class="muted"><c:out value="${portal.employeeNumber}"/> · <c:out value="${portal.designation}"/> · <c:out value="${portal.departmentName}"/></p></div><a class="button secondary" href="<c:url value='/web/notifications'/>">Notifications</a></section>
<section class="panel"><h2>My timetable</h2><div class="table-wrap"><table class="data-table"><thead><tr><th>Day</th><th>Time</th><th>Class</th><th>Subject</th><th>Room</th></tr></thead><tbody><c:forEach items="${portal.timetable}" var="slot"><tr><td><c:out value="${slot.dayOfWeek}"/></td><td><c:out value="${slot.startTime}"/>–<c:out value="${slot.endTime}"/></td><td><c:out value="${slot.className}"/></td><td><c:out value="${slot.subjectName}"/></td><td><c:out value="${slot.room}"/></td></tr></c:forEach></tbody></table></div><c:if test="${empty portal.timetable}"><p class="muted">No active timetable slots are assigned to you.</p></c:if></section>
<section class="panel"><div class="page-heading"><div><h2>Notifications</h2><p class="muted">Notices assigned to your account.</p></div><a class="button secondary" href="<c:url value='/web/notifications'/>">Open inbox</a></div><c:forEach items="${portal.notifications}" var="notice"><article class="notice-card"><h3><c:out value="${notice.title}"/></h3><p><c:out value="${notice.body}"/></p><span class="muted"><c:out value="${notice.publishedAtDisplay}"/></span></article></c:forEach><c:if test="${empty portal.notifications}"><p class="muted">No notifications yet.</p></c:if></section><%@ include file="fragments/footer.jspf" %>
