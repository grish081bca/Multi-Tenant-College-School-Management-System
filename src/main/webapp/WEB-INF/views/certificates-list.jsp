<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ include file="fragments/header.jspf" %>
<section class="page-heading"><div><p class="eyebrow">Academic records</p><h1>Student Certificates</h1><p class="muted">Issue and track certificates for active enrollments.</p></div><c:if test="${canWrite}"><c:url var="addUrl" value="/web/certificates/add"><c:if test="${platformAdmin and not empty selectedTenantId}"><c:param name="tenantId" value="${selectedTenantId}"/></c:if></c:url><a class="button primary" href="${addUrl}">Issue Certificate</a></c:if></section>
<section class="filter-panel"><form class="filter-grid" action="<c:url value='/web/certificates'/>" method="get"><label>Search<input name="q" value="<c:out value='${q}'/>" placeholder="Student, type, or certificate number"></label><c:if test="${platformAdmin}"><label>Tenant<select name="tenantId"><option value="">All tenants</option><c:forEach items="${tenants}" var="tenant"><option value="${tenant.id}" ${tenant.id == selectedTenantId ? 'selected' : ''}><c:out value="${tenant.tenantName}"/></option></c:forEach></select></label></c:if><label>Status<select name="status"><option value="">All</option><c:forEach items="${statuses}" var="value"><option value="${value}" ${value == selectedStatus ? 'selected' : ''}><c:out value="${value}"/></option></c:forEach></select></label><label>Rows<select name="size"><option value="10">10</option><option value="25">25</option><option value="50">50</option></select></label><div class="filter-actions"><button class="primary" type="submit">Apply</button></div></form></section>
<section class="panel"><div class="table-wrap"><table class="data-table"><thead><tr><c:if test="${platformAdmin}"><th>Tenant</th></c:if><th>Certificate</th><th>Student</th><th>Type</th><th>Issued</th><th>Status</th><th>Action</th></tr></thead><tbody><c:forEach items="${page.objects}" var="record"><tr><c:if test="${platformAdmin}"><td><c:out value="${record.tenantName}"/></td></c:if><td><strong><c:out value="${record.certificateNumber}"/></strong><br><c:out value="${record.title}"/></td><td><c:out value="${record.registrationNumber}"/> — <c:out value="${record.studentName}"/></td><td><c:out value="${record.certificateType}"/></td><td><c:out value="${record.issuedOn}"/></td><td><span class="status-pill status-${record.status}"><c:out value="${record.status}"/></span></td><td><c:url var="detailUrl" value="/web/certificates/${record.id}"><c:if test="${platformAdmin}"><c:param name="tenantId" value="${record.tenantId}"/></c:if></c:url><a class="action-button secondary" href="${detailUrl}">View</a></td></tr></c:forEach></tbody></table></div><c:if test="${empty page.objects}"><%@ include file="fragments/data-table-empty.jspf" %></c:if><%@ include file="fragments/pagination.jspf" %></section>
<%@ include file="fragments/footer.jspf" %>
