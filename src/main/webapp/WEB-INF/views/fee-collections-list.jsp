<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %><%@ include file="fragments/header.jspf" %>
<section class="page-heading"><div><p class="eyebrow">Finance</p><h1>Student Fee Collections</h1><p class="muted">Payments are recorded with an immutable receipt number.</p></div><c:if test="${canWrite}"><c:url var="addUrl" value="/web/fee-collections/add"><c:if test="${platformAdmin and not empty selectedTenantId}"><c:param name="tenantId" value="${selectedTenantId}"/></c:if></c:url><a class="button primary" href="${addUrl}">Collect Fee</a></c:if></section>
<section class="filter-panel"><form class="filter-grid" action="<c:url value='/web/fee-collections'/>" method="get"><label>Search<input name="q" value="<c:out value='${q}'/>" placeholder="Receipt, student, or fee"></label><c:if test="${platformAdmin}"><label>Tenant<select name="tenantId"><option value="">All tenants</option><c:forEach items="${tenants}" var="tenant"><option value="${tenant.id}" ${tenant.id == selectedTenantId ? 'selected' : ''}><c:out value="${tenant.tenantName}"/></option></c:forEach></select></label></c:if><button class="primary" type="submit">Apply</button></form></section>
<section class="panel"><div class="table-wrap"><table class="data-table"><thead><tr><c:if test="${platformAdmin}"><th>Tenant</th></c:if><th>Receipt</th><th>Student</th><th>Fee</th><th>Paid</th><th>Method</th><th>Collected</th><th>Balance</th><th></th></tr></thead><tbody><c:forEach items="${page.objects}" var="item"><tr><c:if test="${platformAdmin}"><td><c:out value="${item.tenantName}"/></td></c:if><td><strong><c:out value="${item.receiptNumber}"/></strong></td><td><c:out value="${item.registrationNumber}"/> — <c:out value="${item.studentName}"/></td><td><c:out value="${item.feeName}"/></td><td><c:out value="${item.amount}"/></td><td><c:out value="${item.paymentMethod}"/></td><td><c:out value="${item.collectedAtDisplay}"/></td><td><c:out value="${item.balance}"/></td><td><c:url var="receiptUrl" value="/web/fee-collections/${item.id}/receipt"><c:if test="${platformAdmin}"><c:param name="tenantId" value="${item.tenantId}"/></c:if></c:url><a class="action-button secondary" href="${receiptUrl}">Receipt</a></td></tr></c:forEach></tbody></table></div><c:if test="${empty page.objects}"><%@ include file="fragments/data-table-empty.jspf" %></c:if><%@ include file="fragments/pagination.jspf" %></section><%@ include file="fragments/footer.jspf" %>
