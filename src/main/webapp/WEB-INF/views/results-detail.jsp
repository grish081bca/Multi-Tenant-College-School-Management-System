<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ include file="fragments/header.jspf" %>
<c:url var="resultListUrl" value="/web/results"><c:if test="${platformAdmin}"><c:param name="tenantId" value="${result.tenantId}"/></c:if></c:url>
<section class="tenant-detail-hero"><div class="tenant-identity"><span class="tenant-avatar"><i class="fa-solid fa-square-poll-vertical" aria-hidden="true"></i></span><div><span class="eyebrow">Results Processing</span><h1><c:out value="${result.studentName}"/></h1><div class="tenant-meta"><span><c:out value="${result.registrationNumber}"/></span></div></div></div><div class="tenant-hero-actions"><span class="status-pill status-${result.status}">GPA <c:out value="${result.gpa}"/> / 4.00</span><a class="button secondary" href="${resultListUrl}">Back</a></div></section>
<section class="tenant-info-panel"><div class="tenant-section-heading"><span><i class="fa-solid fa-chart-column" aria-hidden="true"></i></span><div><h2>Term result</h2><p><c:out value="${result.programName}"/> / <c:out value="${result.academicYearName}"/> / <c:out value="${result.semesterName}"/></p></div></div><div class="tenant-detail-list"><c:if test="${platformAdmin}"><div><span>Tenant</span><strong><c:out value="${result.tenantName}"/></strong></div></c:if><div><span>Total marks</span><strong><c:out value="${result.totalMarksObtained}"/> / <c:out value="${result.totalMaximumMarks}"/></strong></div><div><span>Percentage</span><strong><c:out value="${result.percentage}"/>%</strong></div><div><span>GPA</span><strong><c:out value="${result.gpa}"/> / 4.00</strong></div><div><span>Processed</span><strong><c:out value="${result.processedAtDisplay}"/> by <c:out value="${result.processedBy}"/></strong></div></div></section>
<section class="panel"><div class="table-wrap"><table class="data-table"><thead><tr><th>Subject</th><th>Marks</th><th>Percentage</th><th>Credit hours</th><th>Grade point</th></tr></thead><tbody><c:forEach items="${result.courses}" var="course"><tr><td><c:out value="${course.subjectCode}"/> — <c:out value="${course.subjectName}"/></td><td><c:out value="${course.marksObtained}"/> / <c:out value="${course.maximumMarks}"/></td><td><c:out value="${course.percentage}"/>%</td><td><c:out value="${course.creditHours}"/></td><td><c:out value="${course.gradePoint}"/> / 4.00</td></tr></c:forEach><c:if test="${empty result.courses}"><tr><td class="empty-cell" colspan="5">No course results found.</td></tr></c:if></tbody></table></div></section>
<section class="tenant-info-panel tenant-audit-panel"><div class="tenant-section-heading"><span><i class="fa-solid fa-clock-rotate-left" aria-hidden="true"></i></span><div><h2>Entity Change Logs</h2></div></div><div class="table-wrap"><table class="data-table"><thead><tr><th>When</th><th>Action</th><th>Field</th><th>Old value</th><th>New value</th><th>Remarks</th></tr></thead><tbody><c:forEach items="${changeLogs}" var="log"><tr><td><c:out value="${log.createdAtDisplay}"/></td><td><c:out value="${log.action}"/></td><td><c:out value="${empty log.fieldName ? '-' : log.fieldName}"/></td><td><c:out value="${empty log.oldValue ? '-' : log.oldValue}"/></td><td><c:out value="${empty log.newValue ? '-' : log.newValue}"/></td><td><c:out value="${empty log.remarks ? '-' : log.remarks}"/></td></tr></c:forEach></tbody></table></div></section>
<%@ include file="fragments/footer.jspf" %>
