<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %><%@ include file="fragments/header.jspf" %>
<section class="page-heading no-print"><div><p class="eyebrow">Receipt</p><h1>Payment Receipt</h1><p class="muted">Receipt <c:out value="${receipt.receiptNumber}"/></p></div><div><button class="primary" type="button" onclick="window.print()">Print Receipt</button> <a class="button secondary" href="<c:url value='/web/fee-collections'/>">Back</a></div></section>
<section class="panel receipt-panel"><div class="receipt-heading"><div><p class="eyebrow">College ERP</p><h2>Fee Payment Receipt</h2><strong><c:out value="${receipt.tenantName}"/></strong></div><div class="receipt-number"><span>Receipt number</span><strong><c:out value="${receipt.receiptNumber}"/></strong></div></div><hr><div class="detail-grid"><div><span class="meta-label">Student</span><strong><c:out value="${receipt.studentName}"/></strong></div><div><span class="meta-label">Registration number</span><strong><c:out value="${receipt.registrationNumber}"/></strong></div><div><span class="meta-label">Fee item</span><strong><c:out value="${receipt.feeName}"/> (<c:out value="${receipt.feeCode}"/>)</strong></div><div><span class="meta-label">Payment date</span><strong><c:out value="${receipt.collectedAtDisplay}"/></strong></div><div><span class="meta-label">Payment method</span><strong><c:out value="${receipt.paymentMethod}"/></strong></div><div><span class="meta-label">Reference</span><strong><c:out value="${empty receipt.referenceNumber ? '—' : receipt.referenceNumber}"/></strong></div><div><span class="meta-label">Amount received</span><strong><c:out value="${receipt.amount}"/></strong></div><div><span class="meta-label">Collected by</span><strong><c:out value="${receipt.collectedBy}"/></strong></div></div><hr><p class="muted">This receipt records a completed payment. The amount and receipt number are retained in the collection history.</p></section>
<style>@media print{.no-print,.sidebar,.content-header{display:none!important}.main-area{margin:0}.container{max-width:none;padding:0}.receipt-panel{box-shadow:none;border:0}}</style><%@ include file="fragments/footer.jspf" %>
