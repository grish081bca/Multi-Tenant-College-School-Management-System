<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %><%@ include file="fragments/header.jspf" %>
<section class="page-heading"><div><p class="eyebrow">Academic records</p><h1><c:out value="${certificate.title}"/></h1><p class="muted">Certificate <c:out value="${certificate.certificateNumber}"/></p></div><a class="button secondary" href="<c:url value='/web/certificates'/>">Back to register</a></section>
<section class="panel detail-grid"><div><span class="meta-label">Student</span><strong><c:out value="${certificate.registrationNumber}"/> — <c:out value="${certificate.studentName}"/></strong></div><div><span class="meta-label">Type</span><strong><c:out value="${certificate.certificateType}"/></strong></div><div><span class="meta-label">Issued</span><strong><c:out value="${certificate.issuedOn}"/></strong></div><div><span class="meta-label">Status</span><strong><c:out value="${certificate.status}"/></strong></div><c:if test="${not empty certificate.revocationReason}"><div><span class="meta-label">Revocation reason</span><strong><c:out value="${certificate.revocationReason}"/></strong></div></c:if></section>
<c:if test="${canWrite and certificate.status == 'ACTIVE'}"><section class="form-panel"><h2>Revoke certificate</h2><form class="form-grid" method="post" action="<c:url value='/web/certificates/${certificate.id}/revoke'/>"><c:if test="${platformAdmin}"><input type="hidden" name="tenantId" value="${certificate.tenantId}"/></c:if><label>Reason<textarea name="reason" rows="2" maxlength="500" required></textarea></label><button class="danger" type="submit">Revoke</button></form></section></c:if>
<%@ include file="fragments/footer.jspf" %>
