<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %><%@ include file="fragments/header.jspf" %>
<section class="page-heading"><div><p class="eyebrow">My account</p><h1>Notification Inbox</h1><p class="muted">Published college notices addressed to your account.</p></div></section>
<section class="panel"><div class="table-wrap"><table class="data-table"><thead><tr><th>Notice</th><th>Published</th><th>Read status</th><th>Action</th></tr></thead><tbody><c:forEach items="${notifications}" var="item"><tr><td><strong><c:out value="${item.title}"/></strong><p><c:out value="${item.body}"/></p></td><td><c:out value="${item.publishedAtDisplay}"/></td><td><span class="status-pill"><c:out value="${item.read ? 'READ' : 'UNREAD'}"/></span></td><td><c:if test="${not item.read}"><form method="post" action="<c:url value='/web/notifications/${item.id}/read'/>"><button class="action-button primary" type="submit">Mark read</button></form></c:if></td></tr></c:forEach></tbody></table></div><c:if test="${empty notifications}"><p class="muted">There are no notifications yet.</p></c:if></section><%@ include file="fragments/footer.jspf" %>
