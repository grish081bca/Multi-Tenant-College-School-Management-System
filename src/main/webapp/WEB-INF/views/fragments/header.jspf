<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>College ERP</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link rel="stylesheet" href="<c:url
        value='/css/app.css'/>">
    <style>
        .app-shell.sidebar-collapsed .sidebar-nav .menu-text { display: none !important; }
    </style>
</head>
<body>
<div class="app-shell" id="appShell">
    <aside class="sidebar">
        <a class="sidebar-logo" href="<c:url value='/web/dashboard'/>">
            <span class="logo-mark">CE</span>
            <span class="logo-text"><strong>College ERP</strong><small><c:out value="${currentTenantCode}"/></small></span>
        </a>
        <nav class="sidebar-nav">
            <c:forEach items="${allowedMenus}" var="superMenu">
                <c:if test="${empty superMenu.parentMenuId}">
                    <div class="menu-group" data-menu-code="${superMenu.menuCode}" data-menu-id="${superMenu.id}">
                        <c:choose>
                            <c:when test="${not empty superMenu.menuUrl}">
                                <a class="super-menu" href="<c:url value='${superMenu.menuUrl}'/>">
                                    <span class="icon-placeholder">
                                        <c:choose>
                                            <c:when test="${not empty superMenu.icon}">
                                                <i class="<c:out value='${superMenu.icon}' />" aria-hidden="true"></i>
                                            </c:when>
                                            <c:otherwise>
                                                <i class="fa-solid fa-circle" aria-hidden="true"></i>
                                            </c:otherwise>
                                        </c:choose>
                                    </span>
                                    <span class="menu-text"><c:out value="${superMenu.name}"/></span>
                                </a>
                            </c:when>
                            <c:otherwise>
                                <button class="super-menu menu-toggle" type="button">
                                    <span class="icon-placeholder">
                                        <c:choose>
                                            <c:when test="${not empty superMenu.icon}">
                                                <i class="<c:out value='${superMenu.icon}' />" aria-hidden="true"></i>
                                            </c:when>
                                            <c:otherwise>
                                                <i class="fa-solid fa-folder" aria-hidden="true"></i>
                                            </c:otherwise>
                                        </c:choose>
                                    </span>
                                    <span class="menu-text"><c:out value="${superMenu.name}"/></span>
                                    <span class="menu-caret">v</span>
                                </button>
                            </c:otherwise>
                        </c:choose>
                        <div class="sub-menu-list">
                            <c:forEach items="${allowedMenus}" var="subMenu">
                                <c:if test="${subMenu.parentMenuId == superMenu.id and not empty subMenu.menuUrl}">
                                    <a class="sub-menu" href="<c:url value='${subMenu.menuUrl}'/>"><c:out value="${subMenu.name}"/></a>
                                </c:if>
                            </c:forEach>
                        </div>
                    </div>
                </c:if>
            </c:forEach>
        </nav>
    </aside>
    <div class="main-area">
        <header class="content-header">
            <div class="header-title">
                <button class="icon-button sidebar-toggle" type="button" aria-label="Toggle sidebar" aria-expanded="true"><i class="fa-solid fa-bars" aria-hidden="true"></i></button>
                <div>
                    <span class="meta-label">Current page</span>
                    <strong><c:out value="${currentPageName}"/></strong>
                </div>
            </div>
            <div class="user-summary">
                <div>
                    <span class="meta-label">Username</span>
                    <strong><c:out value="${currentUsername}"/></strong>
                </div>
                <div>
                    <span class="meta-label">Last login</span>
                    <strong><c:choose>
                        <c:when test="${empty currentLastLoginAtIso}">Not available</c:when>
                        <c:otherwise><time id="currentLastLoginAt" datetime="<c:out value='${currentLastLoginAtIso}'/>" data-utc="<c:out value='${currentLastLoginAtIso}'/>"><c:out value="${currentLastLoginAt}"/></time></c:otherwise>
                    </c:choose></strong>
                </div>
                <div>
                    <span class="meta-label">Last password change</span>
                    <strong><c:out value="${empty currentPasswordChangedAt ? 'Not available' : currentPasswordChangedAt}"/></strong>
                </div>
                <div>
                    <span class="meta-label">Date and time</span>
                    <strong id="currentDateTime">--</strong>
                </div>
            </div>
            <div class="profile-menu">
                <button class="profile-trigger" type="button" aria-expanded="false">
                    <span class="avatar"><c:out value="${currentUserInitial}"/></span>
                    <span><c:out value="${currentUserFullName}"/></span>
                </button>
                <div class="profile-dropdown">
                    <a href="<c:url value='/web/my-profile'/>">My profile</a>
                    <a href="<c:url value='/web/change-password'/>">Change password</a>
                    <a href="<c:url value='/web/reset-password'/>">Reset password</a>
                    <form action="<c:url value='/web/logout'/>" method="post">
                        <button class="link-button menu-logout" type="submit">Logout</button>
                    </form>
                </div>
            </div>
        </header>
<main class="container">
    <c:if test="${not empty success}">
    <div class="alert success"><c:out value="${success}"/></div>
    </c:if>
    <c:if test="${not empty error}">
    <div class="alert error"><c:out value="${error}"/></div>
    </c:if>
